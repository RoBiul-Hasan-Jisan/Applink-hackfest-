NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://localhost:27017/dengai
FRONTEND_ORIGIN=http://localhost:3000

FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# AppLink. Mode is explicit: simulator (default, no network) | sandbox | live
APPLINK_MODE=simulator
APPLINK_BASE_URL=https://api.applink.com.bd
APPLINK_APPLICATION_ID=
APPLINK_PASSWORD=
APPLINK_SUCCESS_STATUS_CODES=S1000  # documented success code
APPLINK_TEL_STYLE=plain            # plain = tel:8801XXXXXXXXX, plus = tel:+8801XXXXXXXXX (docs are inconsistent; test with Applink)
APPLINK_SOURCE_ADDRESS=            # optional sender id allocated to your app
APPLINK_CALLBACK_ALLOWED_IPS=      # optional, comma-separated, only once Applink confirms its source IPs
APPLINK_USSD_ENABLED=false
APPLINK_SMS_ENABLED=false
APPLINK_OTP_ENABLED=false

# Only add provider callback-auth variables once AppLink documents/confirms a mechanism.
# (WEBHOOK_SECRET from the brief is NOT assumed to be sent by AppLink; see docs/APPLINK_OPEN_QUESTIONS.md)
WEBHOOK_SECRET=

# 32 random bytes, base64: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
PHONE_ENCRYPTION_KEY=
PHONE_HASH_SECRET=
REPORTER_CONTACT_RETENTION_DAYS=30
EVIDENCE_DIR=./evidence-private   # private evidence photos; never serve this directory statically
SMS_LANGUAGE=en                   # keep en until Bangla SMS encoding is confirmed with Applink
SMS_POLL_SECONDS=30
RESPONSE_SLA_HOURS=72
DAILY_REPORT_LIMIT_PER_PHONE=5
